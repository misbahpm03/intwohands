# Copy to .env.local for `vercel dev`, or set these in the Vercel dashboard.
# Every deployment gets its own values — none of this belongs in Git.

# --- the /admin login -----------------------------------------------------

# The /admin password. Change it in the Vercel dashboard any time; no redeploy.
ADMIN_PASSWORD=

# Any long random string. Signs the admin cookie.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SECRET=

# --- storage --------------------------------------------------------------

# Injected automatically when you connect a Blob store to the project.
# You should not need to set this by hand.
BLOB_READ_WRITE_TOKEN=

# Optional. Only needed if two Vercel projects share ONE Blob store, which
# they normally shouldn't. Gives this deployment its own content path.
# BLOB_PREFIX=

# --- sending their reply, via EmailJS -------------------------------------
# These stay on the server. They never reach the page, so nothing about your
# mail setup is visible in the page source. Leave them unset and the reply box
# still works — it just offers copy-to-clipboard instead of sending.

# dashboard.emailjs.com → Email Services
EMAILJS_SERVICE_ID=

# dashboard.emailjs.com → Email Templates. Put {{message}} in the body.
EMAILJS_TEMPLATE_ID=

# dashboard.emailjs.com → Account → API Keys (public key)
EMAILJS_PUBLIC_KEY=

# Account → API Keys (private key). EmailJS blocks non-browser callers by
# default and a serverless function is one, so set this — or instead tick
# "Allow EmailJS API for non-browser applications" and leave it empty.
EMAILJS_PRIVATE_KEY=
